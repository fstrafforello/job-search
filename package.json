{
  "name": "job-search-dashboard",
  "version": "1.2.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local job search dashboard with resume, cover letter and interview help from a built-in local AI or LM Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/fstrafforello/job-search"
  },
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:exe": "node scripts/build-exe.mjs",
    "icons": "node scripts/make-icons.mjs",
    "install-app": "node scripts/install-app.mjs",
    "licenses": "node scripts/licenses.mjs",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0"
  }
}
